@{
    ViewBag.Title = "Settings";
    // Uses the smart layout detection we configured earlier
}

<style>
    /* Match the title font to the clean typography of your librarian headers */
    .settings-page h2 {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 24px;
        color: inherit;
        margin-bottom: 20px;
    }
</style>

<div class="settings-page">
    <h2>Settings</h2>

    <div class="settings-card">
        <h3>Appearance</h3>
        <div class="setting-row">
            <div>
                <strong>Dark Mode</strong>
                <p>Switch between light and dark theme</p>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" id="dark-mode-toggle" onchange="toggleDarkMode(this.checked)" />
                <span class="toggle-slider"></span>
            </label>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load saved dark mode - keeping your exact smooth script logic
        if (localStorage.getItem('darkMode') === 'true') {
            document.body.classList.add('dark');
            document.getElementById('dark-mode-toggle').checked = true;
        }
        if (localStorage.getItem('defaultView')) {
            var defaultViewEl = document.getElementById('default-view');
            if (defaultViewEl) {
                defaultViewEl.value = localStorage.getItem('defaultView');
            }
        }
        function toggleDarkMode(on) {
            document.body.classList.toggle('dark', on);
            document.documentElement.classList.toggle('dark', on); // Added to sync with layout head
            localStorage.setItem('darkMode', on);
        }
        function saveViewPref(val) {
            localStorage.setItem('defaultView', val);
        }
    </script>
}