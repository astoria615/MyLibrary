@using MyLibrary
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Library</title>

    <!-- ⚡ THE FLASH FIXER: Runs instantly before the body elements render -->
    <script type="text/javascript">
        (function () {
            // Check localStorage using the exact storage key your reader app uses
            // (Change "reader-theme" to whatever key your reader setting utilizes if different)
            var savedTheme = localStorage.getItem("librarian-global-theme") || "dark";

            if (savedTheme === "dark") {
                document.documentElement.setAttribute("data-theme", "dark");
                // Adds class to both html and body to satisfy all styling scenarios instantly
                document.documentElement.classList.add("dark-mode");
            } else {
                document.documentElement.setAttribute("data-theme", "light");
                document.documentElement.classList.remove("dark-mode");
            }
        })();
    </script>

    <!-- Your existing CSS style links remain below here -->
    <link href="~/Content/library.css" rel="stylesheet" />
</head>
<body>
    <div class="app-shell">
        <nav class="sidebar">
            <div class="sidebar-brand">MY LIBRARY</div>
            <ul class="sidebar-nav">
                <li>@Html.ActionLink("Home", "Index", "Guest")</li>
                <li class="has-submenu">
                    <a href="#" id="cat-toggle" onclick="toggleCategoryMenu(event)">Category</a>
                    <div class="cat-dropdown" id="cat-dropdown" style="display:none">
                        @try
                        {
                            Html.RenderAction("CategoryMenu", "Guest");
                        }
                        catch (Exception)
                        {
                            <span style="display: block; padding: 10px 15px; font-size: 13px; color: var(--text-muted);">
                                Loading categories...
                            </span>
                        }
                    </div>
                </li>
                @if (Request.IsAuthenticated)
                {
                    <li>@Html.ActionLink("My Borrows", "MyBorrows", "Reader")</li>
                    <li>
                        <a href="@Url.Action("BorrowForm", "Reader")" style="position: relative; display: flex; align-items: center; justify-content: space-between; width: 100%;">
                            <span>Borrow Form</span>
                            <span id="sidebar-basket-count" style="display: none; background-color: #e63946; color: #ffffff; font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 10px; line-height: 1;">0</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("MyFines", "Reader")" class="nav-item nav-fines">
                            My Fines
                            <span class="fine-badge-dot" style="display: none;"></span>
                        </a>
                    </li>
                }
            </ul>
            <div class="sidebar-divider"></div>
            <ul class="sidebar-nav sidebar-nav-bottom">
                <li>
                    @Html.ActionLink("Setting", "Setting", "Guest", null, new { @class = Request.RequestContext.RouteData.Values["action"].ToString() == "Setting" ? "active" : "" })
                </li>
                <li>@Html.ActionLink("Support", "Support", "Guest")</li>
                @if (Request.IsAuthenticated)
                {
                    <li>@Html.ActionLink("Logout", "Logout", "Account")</li>
                }
            </ul>
        </nav>

        <div class="main-area">
            <div class="topbar">
                @using (Html.BeginForm("Search", "Guest", FormMethod.Get, new { @class = "search-form" }))
                {
                    <input type="text" name="q" placeholder="Search by title, ISBN, author, category…"
                           value="@ViewBag.SearchQuery" class="search-input" autocomplete="off" />
                    <button type="submit" class="search-btn">&#9906;</button>
                }

                <div class="topbar-right">
                    @if (Request.IsAuthenticated)
                    {
                        string avatarUrl = Session["AvatarUrl"] != null ? Session["AvatarUrl"].ToString() : "";
                        string fullName = Session["FullName"] != null ? Session["FullName"].ToString() : "User";
                        string avatarSrc = string.IsNullOrEmpty(avatarUrl)
                            ? "/Content/images/default-avatar.png"
                            : avatarUrl;

                        <div class="notif-wrap" id="notif-wrap">
                            <button class="notif-btn" onclick="toggleNotifications()" id="notif-btn">
                                🔔 <span class="notif-badge" id="notif-badge" style="display:none">!</span>
                            </button>
                            <div class="notif-dropdown" id="notif-dropdown" style="display:none"></div>
                        </div>

                        <a href="@Url.Action("Profile","Account")" class="user-chip">
                            <img src="@avatarSrc" class="user-avatar" alt="avatar"
                                 onerror="this.src='/Content/images/default-avatar.png'" />
                            <span class="user-name">@fullName</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login","Account")" class="btn-outline-sm">Log in</a>
                        <a href="@Url.Action("Register","Account")" class="btn-primary-sm">Register</a>
                    }
                </div>
            </div>

            <div class="content-wrap">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/library.js"></script>

    <script type="text/javascript">
        // 1. Synchronize the layout sidebar counter instantly based on client state
        function updateNavbarBasketBadge() {
            var basket = JSON.parse(localStorage.getItem('borrowBasket')) || [];
            var badge = document.getElementById('sidebar-basket-count');
            if (badge) {
                if (basket.length > 0) {
                    badge.textContent = basket.length;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        // 2. Global utility function triggered whenever "Borrow Now" gets clicked across pages
        function addAssetToBorrowForm(bookId, bookTitle) {
            var basket = JSON.parse(localStorage.getItem('borrowBasket')) || [];

            // Rule: Check if already present in the list
            var exists = basket.some(function (item) { return item.id === bookId; });
            if (exists) {
                alert("This item is already added to your current borrow request layout.");
                return;
            }

            // Rule Check: Max 3 books configuration block
            if (basket.length >= 3) {
                alert("System Limit: You can select a maximum of 3 books per single request form.");
                return;
            }

            // Push into local array storage securely
            basket.push({ id: bookId, title: bookTitle });
            localStorage.setItem('borrowBasket', JSON.stringify(basket));

            // Re-render UI bubble state
            updateNavbarBasketBadge();

            alert('"' + bookTitle + '" successfully added to your Borrow Form.');
        }

        // Initialize state on page display
        document.addEventListener("DOMContentLoaded", function () {
            updateNavbarBasketBadge();
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>