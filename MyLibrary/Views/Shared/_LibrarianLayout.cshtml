<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title – Librarian</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/library.css?v=6" />
</head>
<body>
    <div class="app-shell">
        <nav class="sidebar">
            <div class="sidebar-brand">MY LIBRARY</div>
            <ul class="sidebar-nav">
                <li>
                    @Html.ActionLink("Dash board", "Index", "Librarian", null, new { @class = Request.RequestContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "" })
                </li>
                <li>
                    @Html.ActionLink("Borrow request", "BorrowRequests", "Librarian", null, new { @class = Request.RequestContext.RouteData.Values["action"].ToString() == "BorrowRequests" ? "active" : "" })
                </li>
                <li>
                    @Html.ActionLink("Fine management", "FineManagement", "Librarian", null, new { @class = Request.RequestContext.RouteData.Values["action"].ToString() == "FineManagement" ? "active" : "" })
                </li>
                <li>@Html.ActionLink("Report Issue", "ReportIssue", "Librarian")</li>
            </ul>
            <div class="sidebar-divider"></div>
            <ul class="sidebar-nav sidebar-nav-bottom">
                <li>@Html.ActionLink("Setting", "Setting", "Guest")</li>
                <li>@Html.ActionLink("Logout", "Logout", "Account")</li>
            </ul>
        </nav>

        <div class="main-area">
            <div class="topbar">
                <form class="search-form" action="" method="get">
                    <input type="text" class="search-input" placeholder="Search bar" name="search" autocomplete="off" />
                </form>

                <div class="topbar-right">
                    <button class="notif-btn" type="button" style="background: none; border: none; font-size: 16px; cursor: pointer; padding: 4px 8px; color: var(--text-muted);">
                        🔔
                    </button>

                    @{
                        string avatarUrl = Session["AvatarUrl"] != null ? Session["AvatarUrl"].ToString() : "";
                        string fullName = Session["FullName"] != null ? Session["FullName"].ToString() : "User name";
                        string avatarSrc = string.IsNullOrEmpty(avatarUrl) ? "/Content/images/default-avatar.png" : avatarUrl;
                    }
                <a href="@Url.Action("Profile","Account")" class="user-chip">
                    <img src="@avatarSrc" class="user-avatar" alt="avatar"
                         onerror="this.src='/Content/images/default-avatar.png'" />
                    <span class="user-name">@fullName</span>
                </a>
                </div>
            </div>

            <div class="content-wrap">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/library.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>