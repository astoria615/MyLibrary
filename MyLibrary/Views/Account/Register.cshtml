@model MyLibrary.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Create Account</h2>
        <p class="auth-sub">Join My Library today</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert-error" })

            <div class="form-group">
                @Html.LabelFor(m => m.FullName, "Full Name")
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-input", placeholder = "John Doe" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-error" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Email, "Email")
                @Html.TextBoxFor(m => m.Email, new { @class = "form-input", placeholder = "your@email.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Phone, "Phone (optional)")
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-input", placeholder = "0912345678" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Password, "Password")
                @Html.PasswordFor(m => m.Password, new { @class = "form-input", placeholder = "Min. 6 characters" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword, "Confirm Password")
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-input", placeholder = "Repeat password" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })
            </div>
            <button type="submit" class="btn-primary">Create Account</button>
        }

        <p class="auth-switch">
            Already have an account? <a href="@Url.Action("Login","Account")">Sign in</a>
        </p>
    </div>
</div>