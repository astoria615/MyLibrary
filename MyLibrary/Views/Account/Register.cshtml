@model MyLibrary.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Create Account</h2>
        <p class="auth-sub">Join My Library today</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "registrationForm", @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert-error" })

            <!-- STEP 1 -->
            <div id="step-register">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="FullName" name="FullName" class="form-input" placeholder="John Doe" required />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="Email" name="Email" class="form-input" placeholder="your@email.com" required />
                </div>
                <div class="form-group">
                    <label>Phone (optional)</label>
                    <input type="text" id="Phone" name="Phone" class="form-input" placeholder="0912345678" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" id="Password" name="Password" class="form-input" placeholder="Min. 6 characters" required />
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-input" placeholder="Repeat password" required />
                </div>
                <button type="button" id="btnRequestCode" class="btn-primary">
                    Send Verification Code
                </button>
            </div>

            <!-- STEP 2 -->
            <div id="step-verify" style="display:none">
                <div class="alert-success" style="margin-bottom:16px">
                    ✓ Verification code sent to your email.
                </div>
                <div class="form-group">
                    <label>4-Digit Verification Code</label>
                    <input type="text" id="inputCode" name="inputCode" class="form-input"
                           placeholder="0000" maxlength="4" autocomplete="off"
                           style="letter-spacing:10px;font-size:22px;text-align:center" />
                </div>
                <button type="submit" class="btn-primary">Verify &amp; Create Account</button>
                <button type="button" id="btnBack"
                        style="width:100%;margin-top:8px;padding:10px;background:none;
                               border:1px solid var(--border);border-radius:8px;
                               color:var(--text-muted);cursor:pointer;font-size:13px">
                    ← Change Details
                </button>
            </div>
        }

        <p class="auth-switch">
            Already have an account? <a href="@Url.Action("Login","Account")">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
document.getElementById('btnRequestCode').addEventListener('click', function() {
    var email = document.getElementById('Email').value;
    var name = document.getElementById('FullName').value;
    var pass = document.getElementById('Password').value;
    var confirm = document.getElementById('ConfirmPassword').value;

    if (!email || !name || !pass) { alert('Please fill in all required fields.'); return; }
    if (pass !== confirm) { alert('Passwords do not match.'); return; }
    if (pass.length < 6) { alert('Password must be at least 6 characters.'); return; }

    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    fetch('@Url.Action("SendVerificationCode","Account")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ email: email, fullName: name })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            document.getElementById('step-register').style.display = 'none';
            document.getElementById('step-verify').style.display = 'block';
        } else {
            alert(data.message);
            btn.disabled = false;
            btn.textContent = 'Send Verification Code';
        }
    })
    .catch(function() {
        alert('Error sending code. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Send Verification Code';
    });
});

document.getElementById('btnBack').addEventListener('click', function() {
    document.getElementById('step-verify').style.display = 'none';
    document.getElementById('step-register').style.display = 'block';
    var btn = document.getElementById('btnRequestCode');
    btn.disabled = false;
    btn.textContent = 'Send Verification Code';
});
    </script>
}