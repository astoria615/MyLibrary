@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="auth-card">
        <h2>Forgot Password</h2>
        <p class="auth-sub">Enter your email to receive a reset code</p>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert-error" })
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" class="form-input" placeholder="your@email.com" required />
            </div>
            <button type="submit" class="btn-primary">Send Reset Code</button>
        }
        <p class="auth-switch">
            <a href="@Url.Action("Login","Account")">← Back to Login</a>
        </p>
    </div>
</div>