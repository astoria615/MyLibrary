@model MyLibrary.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Welcome back</h2>
        <p class="auth-sub">Sign in to your library account</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }

        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert-error" })

            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-input", placeholder = "your@email.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-input", placeholder = "••••••••" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
            </div>
            <div class="form-check">
                @Html.CheckBoxFor(m => m.RememberMe)
                <label>Remember me</label>
            </div>
            <button type="submit" class="btn-primary">Sign In</button>
        }

        <p class="auth-switch">
            Don't have an account? <a href="@Url.Action("Register","Account")">Register here</a>
        </p>
    </div>
</div>