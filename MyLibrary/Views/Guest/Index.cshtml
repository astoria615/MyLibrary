@model MyLibrary.Models.ViewModels.HomeViewModel
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Check if user is logged in
    bool isUserLoggedIn = Request.IsAuthenticated;
}

<div class="home-layout" style="display: flex; align-items: flex-start; gap: 24px; width: 100%; position: relative;">
    <div class="home-main" style="flex: 1; min-width: 0;">
        <div class="home-banner">
            @if (isUserLoggedIn)
            {
                <div class="banner-greeting">
                    <h1>Hello, @(Session["FullName"] != null ? Session["FullName"].ToString().Split(' ')[0] : "Reader") 👋</h1>
                    <p>What are you looking for today?</p>
                </div>
            }
            else
            {
                <div class="banner-greeting">
                    <h1>Welcome to <span style="color:var(--blue)">My Library</span></h1>
                    <p>Discover, borrow and enjoy thousands of books — all in one place.</p>
                    <div style="display:flex;gap:10px;margin-top:12px">
                        <a href="@Url.Action("Register","Account")" class="btn-primary" style="width:auto;padding:8px 20px;text-decoration:none;display:inline-block">Get Started</a>
                        <a href="@Url.Action("Login","Account")" class="btn-outline-sm" style="padding:8px 20px">Log in</a>
                    </div>
                </div>
            }
        </div>

        <section class="book-section">
            <div class="section-header">
                <h2>New Books</h2>
                <a href="@Url.Action("BookList","Guest",new{sort="newest"})" class="view-all">View all &gt;</a>
            </div>
            <div class="book-grid">
                @foreach (var book in Model.NewBooks.Take(4))
                {
                    <div class="book-card @(Model.SelectedBook != null && Model.SelectedBook.BookId == book.BookId ? "selected" : "")"
                         onclick="selectBook(@book.BookId, this)" style="cursor:pointer;">
                        <div class="book-cover">
                            @if (!string.IsNullOrEmpty(book.CoverUrl))
                            {<img src="@book.CoverUrl" alt="@book.Title" /> }
                            else
                            { <div class="cover-placeholder">📖</div>}
                        </div>
                        <div class="book-meta">
                            <span class="book-title">@book.Title</span>
                            <span class="book-author">@book.AuthorName</span>
                        </div>
                    </div>
                }
            </div>
        </section>

        @if (Model.DynamicBooks != null && Model.DynamicBooks.Count > 0)
        {
            <section class="book-section">
                <div class="section-header">
                    <h2>@(string.IsNullOrEmpty(Model.DynamicSectionTitle) ? "Recommended For You" : Model.DynamicSectionTitle)</h2>
                </div>
                <div class="book-grid">
                    @foreach (var book in Model.DynamicBooks)
                    {
                        <div class="book-card @(Model.SelectedBook != null && Model.SelectedBook.BookId == book.BookId ? "selected" : "")"
                             onclick="selectBook(@book.BookId, this)" style="cursor:pointer;">
                            <div class="book-cover">
                                @if (!string.IsNullOrEmpty(book.CoverUrl))
                                {<img src="@book.CoverUrl" alt="@book.Title" /> }
                                else
                                { <div class="cover-placeholder">📖</div>}
                            </div>
                            <div class="book-meta">
                                <div class="card-stars" style="color: #ffb400; font-size: 0.85rem; margin-bottom: 4px;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span>@(i <= (int)Math.Round((double)book.AverageRating) ? "★" : "☆")</span>
                                    }
                                </div>
                                <span class="book-title">@book.Title</span>
                                <span class="book-author">@book.AuthorName</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="book-section">
            <div class="section-header">
                <h2>Category</h2>
            </div>
            <div class="cat-filter-tabs">
                <a href="@Url.Action("Index","Guest",new{categoryId=0})"
                   class="cat-tab @(Model.SelectedCategoryId == 0 ? "active" : "")">All</a>
                @foreach (var cat in Model.Categories.Take(5))
                {
                    <a href="@Url.Action("Index","Guest",new{categoryId=cat.CategoryId})"
                       class="cat-tab @(Model.SelectedCategoryId == cat.CategoryId ? "active" : "")">
                        @cat.CategoryName
                    </a>
                }
            </div>
            <div class="book-grid">
                @foreach (var book in Model.CategoryBooks.Take(4))
                {
                    <div class="book-card @(Model.SelectedBook != null && Model.SelectedBook.BookId == book.BookId ? "selected" : "")"
                         onclick="selectBook(@book.BookId, this)" style="cursor:pointer;">
                        <div class="book-cover">
                            @if (!string.IsNullOrEmpty(book.CoverUrl))
                            {<img src="@book.CoverUrl" alt="@book.Title" /> }
                            else
                            { <div class="cover-placeholder">📖</div>}
                        </div>
                        <div class="book-meta">
                            <span class="book-title">@book.Title</span>
                            <span class="book-author">@book.AuthorName</span>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>

    <aside class="book-detail-panel" id="detail-panel" style="display:none">
    </aside>
</div>

@section Scripts {
    <script>
        // Store user state globally within view layout logic
        var IS_AUTHENTICATED = @(isUserLoggedIn ? "true" : "false");
        var LOGIN_REDIRECT_URL = '@Url.Action("Login", "Account")';

        function selectBook(bookId, element) {
            var panel = document.getElementById('detail-panel');
            if (!panel) return;

            if (panel.dataset.bookId == bookId && panel.style.display !== 'none') {
                panel.style.display = 'none';
                panel.dataset.bookId = '';
                document.querySelectorAll('.book-card').forEach(function (c) { c.classList.remove('selected'); });
                return;
            }

            document.querySelectorAll('.book-card').forEach(function (c) { c.classList.remove('selected'); });
            if (element) element.classList.add('selected');

            panel.style.display = 'flex';
            panel.innerHTML = '<p style="color:#fff;opacity:#6;font-size:13px;margin:auto">Loading...</p>';

            fetch('/Guest/BookDetail?id=' + bookId)
                .then(function (r) {
                    if (!r.ok) throw new Error('Not found');
                    return r.text();
                })
                .then(function (html) {
                    panel.innerHTML = html;
                    panel.dataset.bookId = bookId;
                    panel.scrollTop = 0;
                    loadBookComments(bookId);

                    // Intercept the inner detail panel borrow actions automatically
                    hookDetailPanelBorrowButton(bookId);
                })
                .catch(function () {
                    panel.style.display = 'none';
                });
        }

        function hookDetailPanelBorrowButton(bookId) {
            setTimeout(function() {
                var detailBtn = document.querySelector('#detail-panel .btn-primary, #detail-panel button');
                if (detailBtn) {
                    // Extract book metadata from current DOM card view text
                    var titleEl = document.querySelector('#detail-panel h2, #detail-panel .detail-title');
                    var titleText = titleEl ? titleEl.textContent.trim() : "Selected Book";

                    // Strip any default standard fetch POST click attributes
                    detailBtn.removeAttribute('onclick');

                    detailBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();

                        // Enforce authentication gate check
                        if (!IS_AUTHENTICATED) {
                            alert("Authentication Required: Please sign in to add items to your borrow request.");
                            window.location.href = LOGIN_REDIRECT_URL;
                            return;
                        }

                        // Call global utility layout functions from custom scripts scope
                        if (typeof addAssetToBorrowForm === "function") {
                            addAssetToBorrowForm(bookId, titleText);
                        }
                    });
                }
            }, 150);
        }

        function loadBookComments(bookId) {
            var container = document.getElementById('reader-comments-list');
            if (!container) return;

            fetch('/Guest/GetBookComments?id=' + bookId)
                .then(function (r) { return r.json(); })
                .then(function (comments) {
                    if (!comments || comments.length === 0) {
                        container.innerHTML = '<p style="opacity:0.5;font-size:0.85rem;margin:0">No reviews yet.</p>';
                        return;
                    }
                    container.innerHTML = '';
                    comments.forEach(function (c) {
                        container.insertAdjacentHTML('beforeend',
                            '<div style="border-bottom:1px solid rgba(255,255,255,0.07);padding-bottom:10px;margin-bottom:10px">' +
                            '<div style="display:flex;justify-content:space-between;margin-bottom:4px">' +
                            '<strong style="font-size:0.85rem;color:#fff">' + (c.UserName || 'Anonymous') + '</strong>' +
                            '<span style="color:#fbbf24;font-size:0.75rem">★ ' + (c.Rating || 5) + '/5</span>' +
                            '</div>' +
                            '<p style="margin:0;font-size:0.85rem;opacity:0.8;line-height:1.4">' + (c.Text || '') + '</p>' +
                            '</div>'
                        );
                    });
                })
                .catch(function () {
                    if (container) container.innerHTML = '<p style="opacity:0.5;font-size:0.85rem;margin:0">Unable to load reviews.</p>';
                });
        }

        document.addEventListener('click', function (e) {
            var panel = document.getElementById('detail-panel');
            if (!panel || panel.style.display === 'none') return;
            if (!e.target.closest('#detail-panel') && !e.target.closest('.book-card')) {
                panel.style.display = 'none';
                panel.dataset.bookId = '';
                document.querySelectorAll('.book-card').forEach(function (c) { c.classList.remove('selected'); });
            }
        });
    </script>
}