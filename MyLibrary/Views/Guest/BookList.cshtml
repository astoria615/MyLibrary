@model MyLibrary.Models.ViewModels.BookListViewModel
@{
    ViewBag.Title = Model.CategoryName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Check if user is logged in to align with Index layout mechanics
    bool isUserLoggedIn = Request.IsAuthenticated;
}

<div class="home-layout">
    <div class="home-main">
        <section class="book-section">
            <div class="section-header">
                <h2>@Model.CategoryName</h2>
                <div class="sort-wrap">
                    <button class="sort-btn" onclick="toggleSortMenu()" id="sort-btn">
                        &#9776; @GetSortLabel(Model.SortBy) <span class="sort-arrow">&#8593;</span>
                    </button>
                    <div class="sort-menu" id="sort-menu" style="display:none">
                        @foreach (var s in new[] { new { val = "title", lbl = "Title" }, new { val = "author", lbl = "Creator" }, new { val = "newest", lbl = "Added" }, new { val = "published", lbl = "Published" }, new { val = "rating", lbl = "Rating" } })
                        {
                            <a href="@Url.Action("BookList","Guest", new{ categoryId=Model.CategoryId, q=Model.SearchQuery, sort=s.val, letter=Model.FilterLetter, view=Model.ViewMode, page=1 })"
                               class="sort-item @(Model.SortBy == s.val ? "active" : "")">@s.lbl</a>
                        }
                    </div>
                </div>
                <div class="view-toggle">
                    <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter=Model.FilterLetter,view="grid", page=Model.CurrentPage})"
                       class="vt-btn @(Model.ViewMode=="grid"?"active":"")">Grid</a>
                    <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter=Model.FilterLetter,view="list", page=Model.CurrentPage})"
                       class="vt-btn @(Model.ViewMode=="list"?"active":"")">List</a>
                </div>
            </div>

            <div class="az-filter">
                @{
                    var letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray();
                }
                <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter="All",view=Model.ViewMode, page=1})"
                   class="az-btn @(Model.FilterLetter=="All"?"active":"")">All</a>
                @foreach (var lt in letters)
                {
                    <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter=lt,view=Model.ViewMode, page=1})"
                       class="az-btn @(Model.FilterLetter==lt.ToString()?"active":"")">@lt</a>
                }
            </div>

            @if (Model.ViewMode == "grid")
            {
                <div class="book-grid">
                    @foreach (var book in Model.Books)
                    {
                        <div class="book-card @(Model.SelectedBook != null && Model.SelectedBook.BookId == book.BookId ? "selected" : "")"
                             onclick="selectBook(event, @book.BookId, 'grid')" style="cursor:pointer;">
                            <div class="book-cover">
                                @if (!string.IsNullOrEmpty(book.CoverUrl))
                                {<img src="@book.CoverUrl" alt="@book.Title" /> }
                                else
                                { <div class="cover-placeholder">📖</div>}
                            </div>
                            <div class="book-meta">
                                <span class="book-title">@book.Title</span>
                                <span class="book-author">@book.AuthorName</span>
                                <span class="book-category" style="display:block; font-size:12px; color:#777; margin-top:2px;">
                                    @book.CategoryName
                                </span>
                                <span class="book-publisher" style="display:block; font-size:12px; color:#777;">
                                    @book.PublisherName
                                </span>
                            </div>
                        </div>
                    }
                    @if (!Model.Books.Any())
                    {
                        <p class="no-results">No books found.</p>
                    }
                </div>
            }
            else
            {
                <table class="book-list-table">
                    <thead>
                        <tr><th>Title</th><th>Author</th><th>Category</th><th>Publisher</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Books)
                        {
                            <tr class="@(Model.SelectedBook != null && Model.SelectedBook.BookId == book.BookId ? "selected" : "")"
                                onclick="selectBook(event, @book.BookId, 'list')" style="cursor:pointer">
                                <td>@book.Title</td>
                                <td>@book.AuthorName</td>
                                <td>@book.CategoryName</td>
                                <td>@book.PublisherName</td>
                            </tr>
                        }
                        @if (!Model.Books.Any())
                        {
                            <tr><td colspan="3" class="no-results">No books found.</td></tr>
                        }
                    </tbody>
                </table>
            }

            @if (Model.TotalPages > 1)
            {
                <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin: 30px 0;">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("BookList", "Guest", new { categoryId = Model.CategoryId, q = Model.SearchQuery, sort = Model.SortBy, letter = Model.FilterLetter, view = Model.ViewMode, page = Model.CurrentPage - 1 })"
                           class="az-btn" style="padding: 6px 12px;">&laquo; Prev</a>
                    }
                    else
                    {
                        <span class="az-btn" style="padding: 6px 12px; opacity: 0.4; cursor: not-allowed;">&laquo; Prev</span>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <span class="az-btn active" style="padding: 6px 12px; font-weight: bold;">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("BookList", "Guest", new { categoryId = Model.CategoryId, q = Model.SearchQuery, sort = Model.SortBy, letter = Model.FilterLetter, view = Model.ViewMode, page = i })"
                               class="az-btn" style="padding: 6px 12px;">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("BookList", "Guest", new { categoryId = Model.CategoryId, q = Model.SearchQuery, sort = Model.SortBy, letter = Model.FilterLetter, view = Model.ViewMode, page = Model.CurrentPage + 1 })"
                           class="az-btn" style="padding: 6px 12px;">Next &raquo;</a>
                    }
                    else
                    {
                        <span class="az-btn" style="padding: 6px 12px; opacity: 0.4; cursor: not-allowed;">Next &raquo;</span>
                    }
                </div>
            }
        </section>
    </div>

    <aside class="book-detail-panel" id="detail-panel" style="display:none">
    </aside>
</div>

@section Scripts {
    <script>
        function selectBook(e, bookId, mode) {
            e.stopPropagation();
            var panel = document.getElementById('detail-panel');
            if (!panel) return;

            // Toggle off if same book
            if (panel.dataset.bookId == bookId && panel.style.display !== 'none') {
                panel.style.display = 'none';
                panel.dataset.bookId = '';
                document.querySelectorAll('.book-card, tbody tr').forEach(function (c) { c.classList.remove('selected'); });
                return;
            }

            // Highlight selected
            document.querySelectorAll('.book-card, tbody tr').forEach(function (c) { c.classList.remove('selected'); });
            if (e.currentTarget) e.currentTarget.classList.add('selected');

            // Show loading
            panel.style.display = 'flex';
            panel.innerHTML = '<p style="color:#fff;opacity:.6;font-size:13px;margin:auto">Loading...</p>';

            fetch('/Guest/BookDetail?id=' + bookId)
                .then(function (r) {
                    if (!r.ok) throw new Error('Not found');
                    return r.text();
                })
                .then(function (html) {
                    panel.innerHTML = html;
                    panel.dataset.bookId = bookId;
                    panel.scrollTop = 0;
                    loadBookComments(bookId);
                })
                .catch(function () {
                    panel.style.display = 'none';
                });
        }

        function loadBookComments(bookId) {
            var container = document.getElementById('reader-comments-list')
                || document.getElementById('reader-reviews-container');
            if (!container) return;

            fetch('/Guest/GetBookComments?id=' + bookId)
                .then(function (r) { return r.json(); })
                .then(function (comments) {
                    if (!comments || comments.length === 0) {
                        container.innerHTML = '<p style="opacity:0.5;font-size:0.85rem;margin:0">No reviews yet.</p>';
                        return;
                    }
                    container.innerHTML = '';
                    comments.forEach(function (c) {
                        container.insertAdjacentHTML('beforeend',
                            '<div style="border-bottom:1px solid rgba(255,255,255,0.07);padding-bottom:10px;margin-bottom:10px">' +
                            '<div style="display:flex;justify-content:space-between;margin-bottom:4px">' +
                            '<strong style="font-size:0.85rem;color:#fff">' + (c.UserName || 'Anonymous') + '</strong>' +
                            '<span style="color:#fbbf24;font-size:0.75rem">★ ' + (c.Rating || 5) + '/5</span>' +
                            '</div>' +
                            '<p style="margin:0;font-size:0.85rem;opacity:0.8;line-height:1.4">' + (c.Text || '') + '</p>' +
                            '</div>'
                        );
                    });
                })
                .catch(function () {
                    if (container) container.innerHTML = '<p style="opacity:0.5;font-size:0.85rem;margin:0">Unable to load reviews.</p>';
                });
        }

        function toggleSortMenu() {
            var m = document.getElementById('sort-menu');
            if (m) m.style.display = m.style.display === 'none' ? 'block' : 'none';
        }

        // Close panel and menus on outside click
        document.addEventListener('click', function (e) {
            // Close sort menu
            var sortBtn = document.getElementById('sort-btn');
            var sortMenu = document.getElementById('sort-menu');
            if (sortMenu && sortBtn && !sortBtn.contains(e.target) && !sortMenu.contains(e.target)) {
                sortMenu.style.display = 'none';
            }

            // Close detail panel
            var panel = document.getElementById('detail-panel');
            if (!panel || panel.style.display === 'none') return;
            if (!e.target.closest('#detail-panel') && !e.target.closest('.book-card') && !e.target.closest('tbody tr')) {
                panel.style.display = 'none';
                panel.dataset.bookId = '';
                document.querySelectorAll('.book-card, tbody tr').forEach(function (c) { c.classList.remove('selected'); });
            }
        });
    </script>
}

@helper GetSortLabel(string sort)
{
    switch (sort)
    {
        case "author":@:Creator
            break;
        case "newest": @:Added
            break;
        case "published": @:Published
            break;
        case "rating": @:Rating
            break;
        default: @:Title
            break;
    }
}