@model MyLibrary.Models.ViewModels.BookListViewModel
@{
    ViewBag.Title = Model.CategoryName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Check if user is logged in to align with Index layout mechanics
    bool isUserLoggedIn = Request.IsAuthenticated;
}

<div class="home-layout">
    <div class="home-main">
        <section class="book-section">
            <div class="section-header">
                <h2>@Model.CategoryName</h2>
                <div class="sort-wrap">
                    <button class="sort-btn" onclick="toggleSortMenu()" id="sort-btn">
                        &#9776; @GetSortLabel(Model.SortBy) <span class="sort-arrow">&#8593;</span>
                    </button>
                    <div class="sort-menu" id="sort-menu" style="display:none">
                        @foreach (var s in new[] { new { val = "title", lbl = "Title" }, new { val = "author", lbl = "Creator" }, new { val = "newest", lbl = "Added" }, new { val = "published", lbl = "Published" }, new { val = "rating", lbl = "Rating" } })
                        {
                            <a href="@Url.Action("BookList","Guest", new{ categoryId=Model.CategoryId, q=Model.SearchQuery, sort=s.val, letter=Model.FilterLetter, view=Model.ViewMode, page=1 })"
                               class="sort-item @(Model.SortBy == s.val ? "active" : "")">@s.lbl</a>
                        }
                    </div>
                </div>
                <div class="view-toggle">
                    <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter=Model.FilterLetter,view="grid", page=Model.CurrentPage})"
                       class="vt-btn @(Model.ViewMode=="grid"?"active":"")">Grid</a>
                    <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter=Model.FilterLetter,view="list", page=Model.CurrentPage})"
                       class="vt-btn @(Model.ViewMode=="list"?"active":"")">List</a>
                </div>
            </div>

            <div class="az-filter">
                @{
                    var letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray();
                }
                <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter="All",view=Model.ViewMode, page=1})"
                   class="az-btn @(Model.FilterLetter=="All"?"active":"")">All</a>
                @foreach (var lt in letters)
                {
                    <a href="@Url.Action("BookList","Guest",new{categoryId=Model.CategoryId,q=Model.SearchQuery,sort=Model.SortBy,letter=lt,view=Model.ViewMode, page=1})"
                       class="az-btn @(Model.FilterLetter==lt.ToString()?"active":"")">@lt</a>
                }
            </div>

            @if (Model.ViewMode == "grid")
            {
                <div class="book-grid">
                    @foreach (var book in Model.Books)
                    {
                        <div class="book-card @(Model.SelectedBook != null && Model.SelectedBook.BookId == book.BookId ? "selected" : "")"
                             onclick="selectBook(event, @book.BookId, 'grid')" style="cursor:pointer;">
                            <div class="book-cover">
                                @if (!string.IsNullOrEmpty(book.CoverUrl))
                                {<img src="@book.CoverUrl" alt="@book.Title" /> }
                                else
                                { <div class="cover-placeholder">📖</div>}
                            </div>
                            <div class="book-meta">
                                <span class="book-title">@book.Title</span>
                                <span class="book-author">@book.AuthorName</span>
                            </div>
                        </div>
                    }
                    @if (!Model.Books.Any())
                    {
                        <p class="no-results">No books found.</p>
                    }
                </div>
            }
            else
            {
                <table class="book-list-table">
                    <thead>
                        <tr><th>Title</th><th>Author</th><th>ISBN</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Books)
                        {
                            <tr class="@(Model.SelectedBook != null && Model.SelectedBook.BookId == book.BookId ? "selected" : "")"
                                onclick="selectBook(event, @book.BookId, 'list')" style="cursor:pointer">
                                <td>@book.Title</td>
                                <td>@book.AuthorName</td>
                                <td>—</td>
                            </tr>
                        }
                        @if (!Model.Books.Any())
                        {
                            <tr><td colspan="3" class="no-results">No books found.</td></tr>
                        }
                    </tbody>
                </table>
            }

            @if (Model.TotalPages > 1)
            {
                <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin: 30px 0;">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("BookList", "Guest", new { categoryId = Model.CategoryId, q = Model.SearchQuery, sort = Model.SortBy, letter = Model.FilterLetter, view = Model.ViewMode, page = Model.CurrentPage - 1 })"
                           class="az-btn" style="padding: 6px 12px;">&laquo; Prev</a>
                    }
                    else
                    {
                        <span class="az-btn" style="padding: 6px 12px; opacity: 0.4; cursor: not-allowed;">&laquo; Prev</span>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <span class="az-btn active" style="padding: 6px 12px; font-weight: bold;">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("BookList", "Guest", new { categoryId = Model.CategoryId, q = Model.SearchQuery, sort = Model.SortBy, letter = Model.FilterLetter, view = Model.ViewMode, page = i })"
                               class="az-btn" style="padding: 6px 12px;">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("BookList", "Guest", new { categoryId = Model.CategoryId, q = Model.SearchQuery, sort = Model.SortBy, letter = Model.FilterLetter, view = Model.ViewMode, page = Model.CurrentPage + 1 })"
                           class="az-btn" style="padding: 6px 12px;">Next &raquo;</a>
                    }
                    else
                    {
                        <span class="az-btn" style="padding: 6px 12px; opacity: 0.4; cursor: not-allowed;">Next &raquo;</span>
                    }
                </div>
            }
        </section>
    </div>

    <aside class="book-detail-panel" id="detail-panel" style="display:@(Model.SelectedBook != null ? "flex" : "none");">
        <div id="detail-panel-content" style="width: 100%; height: 100%; display: flex; flex-direction: column;">
            @if (Model.SelectedBook != null)
            {
                Html.RenderPartial("_BookDetail", Model.SelectedBook);
            }
        </div>
    </aside>
</div>

@section Scripts {
    <script>
        // ADAPTED: Brought over global session state verification trackers from Index view
        var IS_AUTHENTICATED = @(isUserLoggedIn ? "true" : "false");
        var LOGIN_REDIRECT_URL = '@Url.Action("Login", "Account")';

        function toggleSortMenu() {
            var menu = document.getElementById("sort-menu");
            if (menu.style.display === "none") {
                menu.style.display = "block";
            } else {
                menu.style.display = "none";
            }
        }

        // FIXED: Added event argument 'e' payload target reference here
        function selectBook(e, bookId, viewMode) {
            // Cut off bubble propagation chain so document listener doesn't hide it instantly
            if (e && typeof e.stopPropagation === "function") {
                e.stopPropagation();
            }

            var panel = document.getElementById("detail-panel");
            var contentContainer = document.getElementById("detail-panel-content");
            if (!panel || !contentContainer) return;

            // ADAPTED: Added toggle behavior if the same book is clicked repeatedly
            if (panel.dataset.bookId == bookId && panel.style.display !== 'none') {
                panel.style.display = 'none';
                panel.dataset.bookId = '';
                $('.book-card, .book-list-table tr').removeClass('selected');
                return;
            }

            $('.book-card, .book-list-table tr').removeClass('selected');

            // Highlight current targets properly
            if (viewMode === 'grid') {
                $(`.book-card[onclick*="${bookId}"]`).addClass('selected');
            } else {
                $(`.book-list-table tr[onclick*="${bookId}"]`).addClass('selected');
            }

            panel.style.display = "flex";
            contentContainer.innerHTML = '<p style="color:#fff;opacity:0.6;font-size:13px;margin:auto">Loading...</p>';

            // Using your stable jQuery .load method to populate the content wrapper layout container
            $(contentContainer).load('@Url.Action("_BookDetail", "Guest")?id=' + bookId, function(response, status, xhr) {
                if (status === "error") {
                    console.log("Error loading book detail partial view: " + xhr.status + " " + xhr.statusText);
                    panel.style.display = 'none';
                    return;
                }
                panel.dataset.bookId = bookId;
                panel.scrollTop = 0;

                loadBookComments(bookId);
                // ADAPTED: Inject intercept logic onto the newly loaded partial view borrow buttons
                hookDetailPanelBorrowButton(bookId);
            });
        }

        // ADAPTED: Added button state intercept rules matching Index functionality
        function hookDetailPanelBorrowButton(bookId) {
            setTimeout(function() {
                var detailBtn = document.querySelector('#detail-panel .btn-primary, #detail-panel button');
                if (detailBtn) {
                    var titleEl = document.querySelector('#detail-panel h2, #detail-panel .detail-title');
                    var titleText = titleEl ? titleEl.textContent.trim() : "Selected Book";

                    detailBtn.removeAttribute('onclick');

                    detailBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();

                        if (!IS_AUTHENTICATED) {
                            alert("Authentication Required: Please sign in to add items to your borrow request.");
                            window.location.href = LOGIN_REDIRECT_URL;
                            return;
                        }

                        if (typeof addAssetToBorrowForm === "function") {
                            addAssetToBorrowForm(bookId, titleText);
                        }
                    });
                }
            }, 150);
        }

        function loadBookComments(bookId) {
            var reviewContainer = $('#reader-reviews-container');

            if(reviewContainer.length) {
                reviewContainer.html('<p style="font-size: 12px; opacity: 0.7; padding: 4px 0;">Loading comments...</p>');

                $.ajax({
                    url: '@Url.Action("GetBookComments", "Guest")',
                    type: 'GET',
                    data: { id: bookId },
                    success: function (comments) {
                        reviewContainer.empty();

                        if (!comments || comments.length === 0) {
                            reviewContainer.html('<p style="font-size: 12px; opacity: 0.6; font-style: italic; padding: 4px 0;">No reviews yet for this book.</p>');
                            return;
                        }

                        var html = '<div style="display: flex; flex-direction: column; gap: 12px; max-height: 220px; overflow-y: auto; padding-right: 4px;">';

                        $.each(comments, function (index, rev) {
                            var stars = '';
                            for (var i = 1; i <= 5; i++) {
                                stars += i <= rev.Rating ? '★' : '☆';
                            }

                            html += `
                                <div style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                                        <strong style="font-size: 12px; color: #ffffff;">${rev.UserName}</strong>
                                        <span style="color: #ffb703; font-size: 11px;">${stars}</span>
                                    </div>
                                    <p style="font-size: 12px; margin: 0; color: rgba(255,255,255,0.85); line-height: 1.4;">${rev.Text}</p>
                                </div>
                            `;
                        });

                        html += '</div>';
                        reviewContainer.html(html);
                    },
                    error: function () {
                        reviewContainer.html('<p style="font-size: 12px; color: #ff8888; padding: 4px 0;">Failed to load reviews.</p>');
                    }
                });
            }
        }

        // ADAPTED: Refined outside listener to close the sidebar detail panel AND drop menus smoothly
        document.addEventListener('click', function (e) {
            // 1. Handle closing Sort menu if clicked outside
            if (!e.target.matches('.sort-btn')) {
                var dropdowns = document.getElementsByClassName("sort-menu");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.style.display === "block") {
                        openDropdown.style.display = "none";
                    }
                }
            }

            // 2. Handle closing the sidebar details panel if clicked outside card/row selections completely
            var panel = document.getElementById('detail-panel');
            if (!panel || panel.style.display === 'none') return;

            // Checked inside sidebar layout frame node lookup
            var clickedInsidePanel = e.target.closest('#detail-panel');

            if (!clickedInsidePanel) {
                panel.style.display = 'none';
                panel.dataset.bookId = '';
                $('.book-card, .book-list-table tr').removeClass('selected');
            }
        });
    </script>
}

@helper GetSortLabel(string sort)
{
    switch (sort)
    {
        case "author":@:Creator
            break;
        case "newest": @:Added
            break;
        case "published": @:Published
            break;
        case "rating": @:Rating
            break;
        default: @:Title
            break;
    }
}