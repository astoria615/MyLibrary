@model IEnumerable<MyLibrary.Models.ViewModels.AdminBorrowingItem>
@{ ViewBag.Title = "Borrowings"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="lib-dashboard">
    <div class="lib-section">
        <div class="admin-section-header">
            <h2>Manage Borrowings</h2>
        </div>
        <div class="status-tabs">
            @foreach (var s in new[] { "All", "Pending", "Approved", "Returned", "Overdue", "Rejected", "Cancelled" })
            {
                <a href="@Url.Action("Borrowings","Admin",new{status=s})"
                   class="status-tab @(ViewBag.CurrentStatus==s?"active":"")">@s</a>
            }
        </div>
        <table class="book-list-table">
            <thead><tr><th>#</th><th>Reader</th><th>Books</th><th>Borrow Date</th><th>Due</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>#@b.BorrowingId</td>
                        <td>@b.ReaderName</td>
                        <td style="max-width:200px;font-size:12px">@string.Join(", ", b.BookTitles)</td>
                        <td>@b.BorrowDate.ToString("MMM dd, yyyy")</td>
                        <td>@b.DueDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="borrow-status status-@b.Status.ToLower()">@b.Status</span>
                        </td>
                        <td>
                            @if (b.Status == "Returned" || b.Status == "Cancelled")
                            {
                                <span style="font-size:12px;color:var(--text-muted);padding:4px 8px;">Locked</span>
                            }
                            else
                            {
                                <select class="form-input" style="width:130px;padding:4px"
                                        data-borrow-id="@b.BorrowingId"
                                        data-original="@b.Status"
                                        onchange="updateBorrow(@b.BorrowingId, this.value, this)">
                                    @if (b.Status == "Pending")
                                    {
                                        <option value="Pending" selected>Pending</option>
                                        <option value="Approved">Approved</option>
                                        <option value="Rejected">Rejected</option>
                                        <option value="Cancelled">Cancelled</option>
                                    }
                                    else if (b.Status == "Approved")
                                    {
                                        <option value="Approved" selected>Approved</option>
                                        <option value="Returned">Returned</option>
                                        <option value="Overdue">Overdue</option>
                                        <option value="Cancelled">Cancelled</option>
                                    }
                                    else if (b.Status == "Overdue")
                                    {
                                        <option value="Overdue" selected>Overdue</option>
                                        <option value="Returned">Returned</option>
                                        <option value="Cancelled">Cancelled</option>
                                    }
                                    else if (b.Status == "Rejected")
                                    {
                                        <option value="Rejected" selected>Rejected</option>
                                        <option value="Pending">Re-open to Pending</option>
                                    }
                                    else
                                    {
                                        <option value="@b.Status" selected>@b.Status</option>
                                    }
                                </select>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function updateBorrow(id, newStatus, selectEl) {
            var oldStatus = selectEl.dataset.original || selectEl.querySelector('option[selected]')?.value;

            if (!confirm('Change status to "' + newStatus + '"? This cannot be undone.')) {
                // Revert dropdown to original value
                selectEl.value = oldStatus;
                return;
            }

            fetch('/Admin/UpdateBorrowingStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'borrowingId=' + id + '&status=' + encodeURIComponent(newStatus)
            })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d.success) {
                        // Update the status badge in the same row
                        var row = selectEl.closest('tr');
                        var badge = row.querySelector('.borrow-status');
                        if (badge) {
                            badge.textContent = newStatus;
                            badge.className = 'borrow-status status-' + newStatus.toLowerCase();
                        }
                        // Save new value as original
                        selectEl.dataset.original = newStatus;
                    } else {
                        alert('Failed to update status.');
                        selectEl.value = oldStatus;
                    }
                })
                .catch(function () {
                    alert('Network error.');
                    selectEl.value = oldStatus;
                });
        }

        // Store original values on page load
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('select[data-borrow-id]').forEach(function (sel) {
                sel.dataset.original = sel.value;
            });
        });
    </script>
}