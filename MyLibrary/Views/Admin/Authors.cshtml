@model IEnumerable<MyLibrary.Models.Author>
@{ ViewBag.Title = "Authors & Publishers"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="lib-dashboard">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
        <!-- AUTHORS -->
        <div class="lib-section">
            <div class="admin-section-header">
                <h2>Authors</h2>
                <button class="btn-approve" onclick="document.getElementById('add-author-modal').style.display='flex'">+ Add</button>
            </div>
            <table class="book-list-table">
                <thead><tr><th>Name</th><th>Nationality</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.FullName</td>
                            <td>@(a.Nationality ?? "—")</td>
                            <td>
                                <button class="btn-sm-blue" onclick="openEditAuthor(@a.AuthorId,'@a.FullName','@(a.Bio??"")','@(a.Nationality??"")')">Edit</button>
                                <button class="btn-reject" style="padding:4px 10px;font-size:12px;margin-left:4px" onclick="deleteAuthor(@a.AuthorId)">Del</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PUBLISHERS -->
        <div class="lib-section">
            <div class="admin-section-header">
                <h2>Publishers</h2>
                <button class="btn-approve" onclick="document.getElementById('add-pub-modal').style.display='flex'">+ Add</button>
            </div>
            <table class="book-list-table">
                <thead><tr><th>Name</th><th>Email</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var p in ViewBag.Publishers as IEnumerable<MyLibrary.Models.Publisher>)
                    {
                        <tr>
                            <td>@p.PublisherName</td>
                            <td>@(p.Email ?? "—")</td>
                            <td><button class="btn-reject" style="padding:4px 10px;font-size:12px" onclick="deletePub(@p.PublisherId)">Del</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ADD AUTHOR MODAL -->
<div class="modal-overlay" id="add-author-modal" style="display:none" onclick="this.style.display='none'">
    <div class="modal-box" onclick="event.stopPropagation()">
        <h3>Add Author</h3>
        <div class="form-group"><label>Full Name</label><input class="form-input" id="a-name" /></div>
        <div class="form-group"><label>Bio</label><input class="form-input" id="a-bio" /></div>
        <div class="form-group"><label>Nationality</label><input class="form-input" id="a-nat" /></div>
        <div class="modal-actions">
            <button class="btn-approve" onclick="submitAddAuthor()">Add</button>
            <button class="btn-reject" onclick="this.closest('.modal-overlay').style.display='none'">Cancel</button>
        </div>
    </div>
</div>

<!-- EDIT AUTHOR MODAL -->
<div class="modal-overlay" id="edit-author-modal" style="display:none" onclick="this.style.display='none'">
    <div class="modal-box" onclick="event.stopPropagation()">
        <h3>Edit Author</h3>
        <input type="hidden" id="ea-id" />
        <div class="form-group"><label>Full Name</label><input class="form-input" id="ea-name" /></div>
        <div class="form-group"><label>Bio</label><input class="form-input" id="ea-bio" /></div>
        <div class="form-group"><label>Nationality</label><input class="form-input" id="ea-nat" /></div>
        <div class="modal-actions">
            <button class="btn-approve" onclick="submitEditAuthor()">Save</button>
            <button class="btn-reject" onclick="this.closest('.modal-overlay').style.display='none'">Cancel</button>
        </div>
    </div>
</div>

<!-- ADD PUBLISHER MODAL -->
<div class="modal-overlay" id="add-pub-modal" style="display:none" onclick="this.style.display='none'">
    <div class="modal-box" onclick="event.stopPropagation()">
        <h3>Add Publisher</h3>
        <div class="form-group"><label>Name</label><input class="form-input" id="p-name" /></div>
        <div class="form-group"><label>Email</label><input class="form-input" id="p-email" /></div>
        <div class="form-group"><label>Phone</label><input class="form-input" id="p-phone" /></div>
        <div class="form-group"><label>Website</label><input class="form-input" id="p-web" /></div>
        <div class="modal-actions">
            <button class="btn-approve" onclick="submitAddPub()">Add</button>
            <button class="btn-reject" onclick="this.closest('.modal-overlay').style.display='none'">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
function post(url, data) {
    return fetch(url, { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body: new URLSearchParams(data).toString() }).then(r=>r.json());
}
function submitAddAuthor() {
    post('/Admin/AddAuthor', {fullName:document.getElementById('a-name').value, bio:document.getElementById('a-bio').value, nationality:document.getElementById('a-nat').value})
    .then(d=>{ alert(d.message); if(d.success) location.reload(); });
}
function openEditAuthor(id,name,bio,nat) {
    document.getElementById('ea-id').value=id; document.getElementById('ea-name').value=name;
    document.getElementById('ea-bio').value=bio; document.getElementById('ea-nat').value=nat;
    document.getElementById('edit-author-modal').style.display='flex';
}
function submitEditAuthor() {
    post('/Admin/EditAuthor', {id:document.getElementById('ea-id').value, fullName:document.getElementById('ea-name').value, bio:document.getElementById('ea-bio').value, nationality:document.getElementById('ea-nat').value})
    .then(d=>{ alert(d.message); if(d.success) location.reload(); });
}
function deleteAuthor(id) {
    if(!confirm('Delete?')) return;
    post('/Admin/DeleteAuthor',{id:id}).then(d=>{ alert(d.message); if(d.success) location.reload(); });
}
function submitAddPub() {
    post('/Admin/AddPublisher',{name:document.getElementById('p-name').value, email:document.getElementById('p-email').value, phone:document.getElementById('p-phone').value, website:document.getElementById('p-web').value})
    .then(d=>{ alert(d.message); if(d.success) location.reload(); });
}
function deletePub(id) {
    if(!confirm('Delete?')) return;
    post('/Admin/DeletePublisher',{id:id}).then(d=>{ alert(d.message); if(d.success) location.reload(); });
}
    </script>
}