@model MyLibrary.Models.ViewModels.AdminBookEditViewModel

<div class="settings-card">
    <h3>Basic Information</h3>
    <div class="form-row">
        <div class="form-group">
            <label>Title *</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-input", placeholder = "Book title" })
            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "field-error" })
        </div>
        <div class="form-group">
            <label>ISBN</label>
            @Html.TextBoxFor(m => m.ISBN, new { @class = "form-input", placeholder = "978-..." })
        </div>
    </div>

    <!-- AUTHOR AUTOCOMPLETE -->
    <div class="form-row">
        <div class="form-group" style="position:relative">
            <label>Author <span style="font-size:11px;color:var(--text-muted)">(type to search or add new)</span></label>
            <input type="text" id="author-input" class="form-input"
                   placeholder="Type author name..."
                   value="@ViewBag.AuthorName"
                   autocomplete="off"
                   oninput="searchField('author', this.value)" />
            <div class="autocomplete-list" id="author-suggestions"></div>
            @Html.HiddenFor(m => m.AuthorId, new { id = "author-id" })
            <span class="field-new-badge" id="author-new-badge" style="display:none">✦ Will be added as new</span>
        </div>

        <!-- CATEGORY AUTOCOMPLETE -->
        <div class="form-group" style="position:relative">
            <label>Category <span style="font-size:11px;color:var(--text-muted)">(type to search or add new)</span></label>
            <input type="text" id="category-input" class="form-input"
                   placeholder="Type category name..."
                   value="@ViewBag.CategoryName"
                   autocomplete="off"
                   oninput="searchField('category', this.value)" />
            <div class="autocomplete-list" id="category-suggestions"></div>
            @Html.HiddenFor(m => m.CategoryId, new { id = "category-id" })
            <span class="field-new-badge" id="category-new-badge" style="display:none">✦ Will be added as new</span>
        </div>
    </div>

    <!-- PUBLISHER AUTOCOMPLETE -->
    <div class="form-row">
        <div class="form-group" style="position:relative">
            <label>Publisher <span style="font-size:11px;color:var(--text-muted)">(type to search or add new)</span></label>
            <input type="text" id="publisher-input" class="form-input"
                   placeholder="Type publisher name..."
                   value="@ViewBag.PublisherName"
                   autocomplete="off"
                   oninput="searchField('publisher', this.value)" />
            <div class="autocomplete-list" id="publisher-suggestions"></div>
            @Html.HiddenFor(m => m.PublisherId, new { id = "publisher-id" })
            <span class="field-new-badge" id="publisher-new-badge" style="display:none">✦ Will be added as new</span>
        </div>
        <div class="form-group">
            <label>Publish Year</label>
            @Html.TextBoxFor(m => m.PublishYear, new { @class = "form-input", type = "number", placeholder = "2024" })
        </div>
    </div>
</div>

<div class="settings-card">
    <h3>Details</h3>
    <div class="form-row">
        <div class="form-group">
            <label>Total Copies</label>
            @Html.TextBoxFor(m => m.TotalCopies, new { @class = "form-input", type = "number", min = "1" })
        </div>
        <div class="form-group">
            <label>Page Count</label>
            @Html.TextBoxFor(m => m.PageCount, new { @class = "form-input", type = "number" })
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Language</label>
            @Html.TextBoxFor(m => m.Language, new { @class = "form-input", placeholder = "English" })
        </div>
        <div class="form-group">
            <label>Shelf Location</label>
            @Html.TextBoxFor(m => m.ShelfLocation, new { @class = "form-input", placeholder = "A1-01" })
        </div>
    </div>
    <div class="form-group">
        <label>Description</label>
        @Html.TextAreaFor(m => m.Description, new { @class = "form-input", rows = "3" })
    </div>
    <div class="form-check" style="display:flex;align-items:center;gap:8px;margin-top:8px">
        @Html.CheckBoxFor(m => m.IsFeatured)
        <label>Mark as Featured</label>
    </div>
</div>

<div class="settings-card">
    <h3>Cover Image</h3>
    <div class="avatar-upload-row">
        <img id="cover-preview"
             src="@Model.CoverUrl"
             alt="Cover preview"
             style="width:80px;height:110px;object-fit:cover;border-radius:8px;
                    border:1px solid var(--border);
                    display:@(string.IsNullOrEmpty(Model.CoverUrl)?"none":"block")"
             onerror="this.style.display='none'" />
        <div>
            <input type="file" id="cover-file-input" accept="image/*"
                   style="display:none" onchange="previewCoverFile(this)" />
            <button type="button" class="btn-choose-avatar"
                    onclick="document.getElementById('cover-file-input').click()">
                Choose Cover Image
            </button>
            <p class="text-muted" style="margin-top:6px;font-size:12px">
                JPG, PNG. Resized before saving.
            </p>
        </div>
    </div>
    @Html.HiddenFor(m => m.CoverUrl, new { id = "cover-url-hidden" })
</div>
