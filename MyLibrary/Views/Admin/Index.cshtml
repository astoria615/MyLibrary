@using System.Collections.Generic
@using System.Linq
@model MyLibrary.Models.ViewModels.AdminDashboardViewModel

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="lib-dashboard">
    <div class="stat-cards" style="grid-template-columns:repeat(3,1fr)">
        <div class="stat-card">
            <span class="stat-card-num">@Model.TotalBooks</span>
            <span class="stat-card-label">Total Books</span>
        </div>

        <div class="stat-card">
            <span class="stat-card-num">@Model.TotalReaders</span>
            <span class="stat-card-label">Total Readers</span>
        </div>

        <div class="stat-card">
            <span class="stat-card-num">@Model.TotalBorrowings</span>
            <span class="stat-card-label">Total Borrowings</span>
        </div>

        <div class="stat-card stat-card-warn">
            <span class="stat-card-num">$@Model.TotalFines.ToString("F2")</span>
            <span class="stat-card-label">Total Fines Issued</span>
        </div>

        <div class="stat-card stat-card-blue">
            <span class="stat-card-num">@Model.ActiveBorrowings</span>
            <span class="stat-card-label">Active Borrowings</span>
        </div>

        <div class="stat-card">
            <span class="stat-card-num" style="color:#a32d2d">@Model.PendingFines</span>
            <span class="stat-card-label">Unpaid Fines</span>
        </div>
    </div>

    <!-- Reader Statistics -->
    <div class="lib-section">
        <h2>Reader Statistics</h2>

        <div class="stat-cards" style="grid-template-columns:repeat(3,1fr)">
            <div class="stat-card stat-card-blue">
                <span class="stat-card-num">@ViewBag.ActiveReaders</span>
                <span class="stat-card-label">Active Readers</span>
            </div>

            <div class="stat-card stat-card-warn">
                <span class="stat-card-num">@ViewBag.InactiveReaders</span>
                <span class="stat-card-label">Inactive Readers</span>
            </div>

            <div class="stat-card">
                <span class="stat-card-num">@ViewBag.NewReadersThisMonth</span>
                <span class="stat-card-label">New Readers This Month</span>
            </div>
        </div>
    </div>

    <!-- Borrowing Trends Over Time -->
    <div class="lib-section">
        <h2>Borrowing Statistics</h2>

        <div style="width:100%;height:330px">
            <canvas id="borrowingChart"></canvas>
        </div>
    </div>

    <!-- Top Borrowed Books Chart -->
    <div class="lib-section">
        <h2>Top Borrowed Books</h2>

        <div style="width:100%;height:420px">
            <canvas id="topBorrowedBooksChart"></canvas>
        </div>

        <div id="topBooksEmptyMessage" style="display:none;margin-top:12px;color:#777">
            No borrowing data available.
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
        <div class="lib-section">
            <h2>Recent Borrowings</h2>

            @if (Model.RecentBorrowings != null && Model.RecentBorrowings.Any())
            {
                foreach (var b in Model.RecentBorrowings)
                {
                    <div class="admin-row">
                        <div>
                            <span class="admin-row-title">@b.ReaderName</span>
                            <span class="admin-row-sub">@string.Join(", ", b.BookTitles)</span>
                        </div>

                        <span class="borrow-status status-@b.Status.ToLower()">@b.Status</span>
                    </div>
                }
            }
            else
            {
                <div class="admin-row">
                    <div>
                        <span class="admin-row-title">No recent borrowings</span>
                        <span class="admin-row-sub">There are no borrowing records yet.</span>
                    </div>
                </div>
            }
        </div>

        <div class="lib-section">
            <h2>Recent Fines</h2>

            @if (Model.RecentFines != null && Model.RecentFines.Any())
            {
                foreach (var f in Model.RecentFines)
                {
                    <div class="admin-row">
                        <div>
                            <span class="admin-row-title">@f.ReaderName</span>
                            <span class="admin-row-sub">@f.FineType · $@f.Amount.ToString("F2")</span>
                        </div>

                        <span class="borrow-status status-@f.PaymentStatus.ToLower().Replace(" ", "")">@f.PaymentStatus</span>
                    </div>
                }
            }
            else
            {
                <div class="admin-row">
                    <div>
                        <span class="admin-row-title">No recent fines</span>
                        <span class="admin-row-sub">There are no fine records yet.</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Borrowing Statistics - Line / Area Chart
    var borrowLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BorrowingChartLabels));
    var borrowData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BorrowingChartData));

    var borrowingCanvas = document.getElementById('borrowingChart');

    if (borrowingCanvas) {
        var maxBorrow = borrowData && borrowData.length > 0 ? Math.max.apply(null, borrowData) : 0;
        var suggestedBorrowMax = maxBorrow < 5 ? 5 : maxBorrow + 2;

        var ctx = borrowingCanvas.getContext('2d');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: borrowLabels,
                datasets: [{
                    label: 'Borrowings',
                    data: borrowData,
                    borderWidth: 2,
                    tension: 0.35,
                    fill: true,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return 'Borrowings: ' + context.raw;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            maxRotation: 45,
                            minRotation: 45
                        },
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        beginAtZero: true,
                        suggestedMax: suggestedBorrowMax,
                        ticks: {
                            precision: 0,
                            stepSize: 1
                        }
                    }
                }
            }
        });
    }

    // Top Borrowed Books - Horizontal Bar Chart
    var topBookLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.TopBorrowedBookLabels));
    var topBookData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.TopBorrowedBookData));

    var topBookCanvas = document.getElementById('topBorrowedBooksChart');
    var topBooksEmptyMessage = document.getElementById('topBooksEmptyMessage');

    if (topBookCanvas && topBookLabels && topBookLabels.length > 0) {
        var maxTopBook = topBookData && topBookData.length > 0 ? Math.max.apply(null, topBookData) : 0;
        var suggestedTopBookMax = maxTopBook < 5 ? 5 : maxTopBook + 2;

        var topBookCtx = topBookCanvas.getContext('2d');

        new Chart(topBookCtx, {
            type: 'bar',
            data: {
                labels: topBookLabels,
                datasets: [{
                    label: 'Borrow Count',
                    data: topBookData,
                    borderWidth: 1,
                    barThickness: 28,
                    maxBarThickness: 36,
                    categoryPercentage: 0.75,
                    barPercentage: 0.8
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return 'Borrow Count: ' + context.raw;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        suggestedMax: suggestedTopBookMax,
                        ticks: {
                            precision: 0,
                            stepSize: 1
                        }
                    },
                    y: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    } else {
        if (topBooksEmptyMessage) {
            topBooksEmptyMessage.style.display = 'block';
        }
    }
</script>