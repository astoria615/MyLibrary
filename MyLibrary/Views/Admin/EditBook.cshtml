@model MyLibrary.Models.ViewModels.AdminBookEditViewModel
@{
    ViewBag.Title = "Edit Book";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="lib-dashboard">
    <div class="lib-section" style="max-width:700px">
        <div class="admin-section-header">
            <h2>Edit Book</h2>
            <a href="@Url.Action("Books","Admin")" class="btn-sm-blue" style="text-decoration:none">← Back</a>
        </div>

        @using (Html.BeginForm("EditBook", "Admin", FormMethod.Post, new { @class = "profile-form", id = "book-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.BookId)
            @Html.ValidationSummary(true, "", new { @class = "alert-error" })

            @Html.Partial("_BookFormFields", Model)

            <div style="display:flex;align-items:center;gap:12px;margin-top:8px">
                <button type="submit" class="btn-primary" style="width:auto;padding:10px 28px"
                        onclick="return resolveNewEntries()">
                    Save Changes
                </button>
                <a href="@Url.Action("Books","Admin")" style="font-size:13px;color:var(--text-muted)">Cancel</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        var timers = {};

        function searchField(field, val) {
            var badge = document.getElementById(field + '-new-badge');
            var hiddenId = document.getElementById(field + '-id');
            hiddenId.value = '';
            badge.style.display = 'none';
            clearTimeout(timers[field]);
            if (!val || val.length < 1) {
                document.getElementById(field + '-suggestions').style.display = 'none';
                return;
            }
            timers[field] = setTimeout(function () {
                var urls = { author: '/Admin/SearchAuthors', category: '/Admin/SearchCategories', publisher: '/Admin/SearchPublishers' };
                fetch(urls[field] + '?q=' + encodeURIComponent(val)).then(r => r.json()).then(data => { renderSuggestions(field, data, val); });
            }, 250);
        }

        function renderSuggestions(field, data, inputVal) {
            var list = document.getElementById(field + '-suggestions');
            var html = '';
            if (data.length > 0) {
                data.forEach(function (item) {
                    var id, name;
                    if (field === 'author') { id = item.AuthorId; name = item.FullName; }
                    else if (field === 'category') { id = item.CategoryId; name = item.CategoryName; }
                    else if (field === 'publisher') { id = item.PublisherId; name = item.PublisherName; }
                    html += '<div class="autocomplete-item" onclick="selectField(\'' + field + '\',' + id + ',\'' + name.replace(/'/g, "\\'") + '\')">' + name + '</div>';
                });
            }
            html += '<div class="autocomplete-item autocomplete-add" onclick="markAsNew(\'' + field + '\',\'' + inputVal.replace(/'/g, "\\'") + '\')">✦ Add new: <strong>' + inputVal + '</strong></div>';
            list.innerHTML = html;
            list.style.display = 'block';
        }

        function selectField(field, id, name) {
            document.getElementById(field + '-input').value = name;
            document.getElementById(field + '-id').value = id;
            document.getElementById(field + '-suggestions').style.display = 'none';
            document.getElementById(field + '-new-badge').style.display = 'none';
        }

        function markAsNew(field, name) {
            document.getElementById(field + '-input').value = name;
            document.getElementById(field + '-id').value = '';
            document.getElementById(field + '-suggestions').style.display = 'none';
            document.getElementById(field + '-new-badge').style.display = 'inline-block';
        }

        async function resolveNewEntries() {
            var fields = [
                { field: 'author', createUrl: '/Admin/GetOrCreateAuthor', inputId: 'author-input', hiddenId: 'author-id' },
                { field: 'category', createUrl: '/Admin/GetOrCreateCategory', inputId: 'category-input', hiddenId: 'category-id' },
                { field: 'publisher', createUrl: '/Admin/GetOrCreatePublisher', inputId: 'publisher-input', hiddenId: 'publisher-id' }
            ];
            for (var i = 0; i < fields.length; i++) {
                var f = fields[i];
                var name = document.getElementById(f.inputId).value.trim();
                var id = document.getElementById(f.hiddenId).value;
                if (name && !id) {
                    var resp = await fetch(f.createUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'name=' + encodeURIComponent(name)
                    }).then(r => r.json());
                    if (resp.success) document.getElementById(f.hiddenId).value = resp.id;
                }
            }
            return true;
        }

        function previewCoverFile(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = new Image();
                    img.onload = function () {
                        var canvas = document.createElement('canvas');
                        var maxW = 400, maxH = 600;
                        var w = img.width, h = img.height;
                        if (w / h > maxW / maxH) { if (w > maxW) { h = h * maxW / w; w = maxW; } }
                        else { if (h > maxH) { w = w * maxH / h; h = maxH; } }
                        canvas.width = w; canvas.height = h;
                        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                        var dataUrl = canvas.toDataURL('image/jpeg', 0.85);
                        var preview = document.getElementById('cover-preview');
                        preview.src = dataUrl;
                        preview.style.display = 'block';
                        document.getElementById('cover-url-hidden').value = dataUrl;
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.addEventListener('click', function (e) {
            ['author', 'category', 'publisher'].forEach(function (field) {
                var input = document.getElementById(field + '-input');
                var list = document.getElementById(field + '-suggestions');
                if (list && input && !input.contains(e.target) && !list.contains(e.target))
                    list.style.display = 'none';
            });
        });
    </script>
}